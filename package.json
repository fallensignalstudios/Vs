{
  "name": "aurelion-contrary-witness",
  "private": true,
  "version": "0.1.0",
  "description": "Sovereign Call: Origins — Aurelion / Contrary Witness. Browser vertical slice.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "build:ship": "tsc --noEmit && VITE_HOST_B64=1 vite build && node tools/pack-vo.mjs && node tools/pack-b64.mjs",
    "serve:ship": "node tools/serve-dist.mjs --port 4173 --prefix /a/b/game/",
    "ship:plan": "node tools/publish-plan.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "n8ao": "^2.0.1",
    "postprocessing": "^6.39.6",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
